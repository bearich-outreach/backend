# ============================================================
# Contoh konfigurasi backend Bearich Outreach API
#
# >>> UNTUK LOKAL (node dist/index.js): salin ke .env <<<
# >>> UNTUK PRODUKSI (container Portainer): nilai-nilai ini
#     diset sebagai environment variable pada stack, TIDAK perlu
#     file .env di dalam container. Lihat docker-compose.yml.
# ============================================================

# MySQL
# - Lokal: localhost
# - Container: nama container MySQL pada Docker network yang sama
DB_HOST=localhost
DB_PORT=3306
DB_USER=bearich
DB_PASSWORD=ganti_password_mysql
DB_NAME=bearich

# Server
PORT=4000

# Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti_password_login_kuat
SESSION_SECRET=ganti_dengan_string_acak_panjang

# CORS: origin frontend (Vercel). Pisahkan dengan koma jika lebih dari satu.
CORS_ORIGIN=https://bearich-outreach.vercel.app

# Cookie lintas situs (frontend Vercel berbeda origin dengan backend duckdns)
COOKIE_SAMESITE=none
NODE_ENV=production

# Opsional: hanya jika frontend & backend berada di subdomain yang sama
# (mis. app.example.com & api.example.com). Untuk setup ini TIDAK diperlukan.
# COOKIE_DOMAIN=.example.com

# Autopilot (REDESIGN_OUTREACH.md)
WA_GATEWAY_URL=http://evolution:8080
WA_GATEWAY_KEY=ganti_apikey_evolution
WA_INSTANCE=bearich-wa1
WA_WEBHOOK_SECRET=ganti_random_hex_32
AUTOPILOT_DRY_RUN=true
DAILY_DEEPSEEK_LIMIT=15
PROXY_URL=
DEEPSEEK_API_KEY=ganti_sk_deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Scraper Google Maps asli via Playwright (tanpa API berbayar)
# - Production: USE_PLAYWRIGHT=true, MOCK_SCRAPE=false (JANGAN mock di prod)
# - Dev lokal: MOCK_SCRAPE=true agar cepat tanpa membuka browser
USE_PLAYWRIGHT=false
MOCK_SCRAPE=true
RESULTS_PER_KEYWORD=6